# Copie a .env para cambiar puertos o credenciales (todas las variables son opcionales).

FRONTEND_PORT=3000
BACKEND_PORT=8080
# URL del backend vista desde el navegador (cámbiela si abre el dashboard desde otro equipo)
PUBLIC_API_URL=http://localhost:8080
MQTT_PORT=1883
MQTT_WS_PORT=9001
MONGO_PORT=27017
MONGO_EXPRESS_PORT=8081

# Credenciales de MongoDB (solo desarrollo; cámbielas fuera de su PC)
MONGO_USER=root
MONGO_PASSWORD=secret
